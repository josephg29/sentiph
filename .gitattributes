# Normalize line endings so tooling (Biome formatter defaults to LF) behaves
# identically on Windows, macOS, and Linux. Without this, a Windows checkout
# with core.autocrlf=true gets CRLF working-tree files and `pnpm lint` reports
# every file as needing reformatting.
* text=auto eol=lf

# Windows-only scripts should keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Treat common binary assets as binary (never normalize).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp3 binary
*.wav binary
