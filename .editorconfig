# EditorConfig — https://editorconfig.org
# Mirrors biome.json (space indent, width 2, line width 100).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
max_line_length = 100
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown uses trailing whitespace for hard line breaks.
[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
