{
  "name": "sentiph",
  "version": "0.1.0",
  "description": "Web-first command surface for running multiple coding agents in parallel",
  "license": "MIT",
  "author": "Joseph Gannon (https://github.com/josephg29)",
  "homepage": "https://github.com/josephg29/sentiph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josephg29/sentiph.git"
  },
  "bugs": {
    "url": "https://github.com/josephg29/sentiph/issues"
  },
  "keywords": [
    "claude-code",
    "ai-agents",
    "multi-agent",
    "orchestration",
    "terminal",
    "developer-tools"
  ],
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "sentiph": "./bin/sentiph"
  },
  "files": ["bin", "dist", "README.md"],
  "scripts": {
    "start": "pnpm dev",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @sentiph/web build && pnpm --filter @sentiph/web exec vite build --config vite.api.bundle.config.mts && node scripts/build-package.mjs",
    "smoke:public-install": "node scripts/smoke-public-install.mjs",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "ws": "^8.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild", "node-pty"]
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.10",
    "knip": "^6.3.1",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
