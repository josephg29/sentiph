# Sentiph environment variables
# Copy this file to .env and uncomment the variables you want to override.
# All variables are optional — Sentiph works with zero configuration.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# TCP port the API server listens on (default: 8787)
# SENTIPH_API_PORT=8787

# Full origin the API advertises — override if running behind a reverse proxy
# SENTIPH_API_ORIGIN=http://127.0.0.1:8787

# Set to 1 to allow connections from non-localhost addresses.
# WARNING: enabling this exposes the server beyond loopback. Combine with a
# reverse proxy and firewall rules.
#
# Token authentication: in remote mode every non-loopback request must present a
# pairing token, issued at startup (random, in-memory, never persisted). Provide
# it either as an Authorization header (`Authorization: Bearer <token>`) or a
# query parameter (`?token=<token>`). Loopback requests are always exempt, so
# local usage is unaffected. A local operator can read the current token from the
# loopback-only endpoint `GET http://127.0.0.1:<port>/api/pairing` (the token is
# returned only to loopback callers) and hand it to the remote client.
# SENTIPH_ALLOW_REMOTE_ACCESS=0

# Set to 1 to skip auto-opening the browser tab on startup
# SENTIPH_NO_OPEN=0

# ---------------------------------------------------------------------------
# Workspace & state
# ---------------------------------------------------------------------------

# Directory Sentiph treats as the root workspace (default: current directory)
# SENTIPH_WORKSPACE_CWD=/path/to/your/project

# Directory where .sentiph/ state files are stored
# (default: $SENTIPH_WORKSPACE_CWD/.sentiph)
# SENTIPH_PROJECT_STATE_DIR=

# Directory for built-in prompt templates loaded at server start
# SENTIPH_PROMPTS_DIR=

# Path to the built web UI dist/ directory (set automatically by the CLI)
# SENTIPH_WEB_DIST_DIR=

# ---------------------------------------------------------------------------
# Session limits
# ---------------------------------------------------------------------------

# Maximum number of concurrent PTY terminal sessions (default: 32)
# SENTIPH_MAX_TERMINAL_SESSIONS=32

# HTTP rate limits (per client) for write-heavy terminal endpoints. Defaults are
# generous so legitimate fast multi-agent spawning is never throttled; only
# pathological floods are blunted. The WebSocket input path is NOT covered.
# Max POST /api/terminals (create) requests per 60s window (default: 120)
# SENTIPH_RATELIMIT_CREATE_PER_MIN=120
# Max POST /api/terminals/:id/input requests per 10s window (default: 600)
# SENTIPH_RATELIMIT_INPUT_PER_10S=600

# ---------------------------------------------------------------------------
# Debugging
# ---------------------------------------------------------------------------

# Set to 1 to enable verbose HTTP request logging
# SENTIPH_VERBOSE_LOGS=0

# Set to 1 to write raw PTY session data to disk for debugging.
# NOTE: this captures everything typed in terminal sessions, including passwords.
# SENTIPH_DEBUG_PTY_LOGS=0

# Directory for PTY debug log files (default: $SENTIPH_PROJECT_STATE_DIR/logs)
# SENTIPH_DEBUG_PTY_LOG_DIR=
